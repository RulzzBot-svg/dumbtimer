# Giphy dashboard keys work here — SDK and REST search use the same key.
# Get one at https://developers.giphy.com/dashboard/
VITE_GIPHY_API_KEY=

# Neon Postgres. Copy the pooled connection string from https://console.neon.tech
# (Dashboard → Connection string → pooled). Same value goes in Vercel as DATABASE_URL.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
