# Giphy dashboard keys work here — SDK and REST search use the same key.
# Get one at https://developers.giphy.com/dashboard/
VITE_GIPHY_API_KEY=

# Local accounts DB (created automatically). For Vercel production, use Turso:
# LIBSQL_URL=libsql://your-db.turso.io
# LIBSQL_AUTH_TOKEN=
LIBSQL_URL=file:data/desk.db

